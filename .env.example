# Required: get an API key from https://aisstream.io/
AISSTREAM_API_KEY=replace-with-your-aisstream-api-key

# Amerigo Vespucci MMSI. Leave this value unless tracking a different vessel.
TARGET_MMSI=247999000

# Existing ArcGIS hosted feature layer item ID.
ARCGIS_ITEM_ID=fea75f4405ec44e8bf099ab2cb054a33

# ArcGIS credentials. ARCGIS_TOKEN is the permanent restricted runtime token.
ARCGIS_TOKEN=
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# Optional one-time schema bootstrap token. Use only when setup needs to add missing fields, then remove it immediately.
ARCGIS_ADMIN_TOKEN=
ARCGIS_PORTAL_URL=https://www.arcgis.com

# Optional direct FeatureServer URL for read-only public REST diagnostics.
ARCGIS_FEATURE_SERVICE_URL=https://services9.arcgis.com/HWLvgMBDdrPG7U8N/arcgis/rest/services/Amerigo_Vespucci_Live/FeatureServer
ARCGIS_CURRENT_LAYER_ID=0
ARCGIS_HISTORY_LAYER_ID=1
ARCGIS_TRAVELLED_ROUTE_LAYER_ID=2
ARCGIS_DESTINATION_LAYER_ID=3
ARCGIS_ESTIMATED_ROUTE_LAYER_ID=4

# Service behavior.
PORT=3000
LOG_LEVEL=info
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
ENABLE_HISTORY=true
HISTORY_MIN_INTERVAL_SECONDS=300
ROUTE_MAX_HISTORY_POINTS=5000
ETA_MIN_SPEED_KNOTS=1
DESTINATION_NAME=Ponta Delgada, Portugal
DESTINATION_PORT_CODE=PTPDL
DESTINATION_LATITUDE=37.734722
DESTINATION_LONGITUDE=-25.664444
HEALTH_STALE_AFTER_SECONDS=1800

# Optional Data Docked fallback. Leave API key blank to keep AISStream-only behavior.
# Data Docked requires ENABLE_DATA_DOCKED=true AND DATADOCKED_API_KEY — default is off.
ENABLE_DATA_DOCKED=false
DATADOCKED_API_KEY=
DATADOCKED_BASE_URL=https://datadocked.com/api/vessels_operations
DATADOCKED_POLL_INTERVAL_SECONDS=1800
DATADOCKED_AIS_STALE_SECONDS=300

# Build 2 optional Open-Meteo model weather and marine conditions on Layer 5.
ENABLE_CONDITIONS=true
ARCGIS_CONDITIONS_LAYER_ID=5
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_API_KEY=
OPEN_METEO_REFRESH_SECONDS=1800
OPEN_METEO_FORECAST_HOURS=24
OPEN_METEO_MAX_POSITION_AGE_SECONDS=21600
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=15

# IQAI Spatial V2 shell (development only — NOT the production interface)
IQAI_V2_ENABLED=false
IQAI_TASKGRAPH_V1_ENABLED=false
# Progressive intelligence (Agent 2 governed live path) — default ON; set false for emergency rollback only
IQAI_PROGRESSIVE_INTELLIGENCE_V1_ENABLED=true
# Interactive intelligence deadline before partial/degraded return (ms)
IQAI_INTERACTIVE_INTELLIGENCE_DEADLINE_MS=30000
IQAI_CROSS_AGENT_SPATIAL_V1_ENABLED=false
IQAI_ESRI_AGENTIC_V1_ENABLED=false
IQAI_PLACE_POI_V1_ENABLED=true
SPATIAL_LAYERS_ENABLED=true
LEGACY_UI_ENABLED=true
RADAR_ENABLED=false
OCEAN_VIEW_WEBMAP_ID=86f1b6a9b6124da5b362964749b5d797

# IQAI Spatial V1 — Montreal 1 browser OAuth (public client ID only)
MONTREAL_OPERATIONAL_WEBMAP_ID=2ec27986ecfb4dd188d058cae620be0d
MONTREAL_ARCGIS_OAUTH_APP_ID=

# STM GTFS-Realtime (server-side only — never expose to browser)
STM_API_KEY=

# IQAI Point Intelligence broker (Agent 5) — server-side proxy target only
POINT_INTELLIGENCE_BROKER_URL=http://127.0.0.1:3015
POINT_INTELLIGENCE_TIMEOUT_MS=30000

# Agent 2 intelligence store (open-world / historical) — server-side only
INTELLIGENCE_STORE_ROOT=../amerigo-vespucci-intelligence-connectors/data/intelligence/store

# IQAI Spatial intelligence research — server-side only (never expose to browser)
OPENAI_API_KEY=
IQAI_INTELLIGENCE_RESEARCH_MODEL=gpt-4o
GEMINI_API_KEY=
IQAI_GEMINI_RESEARCH_MODEL=gemini-flash-latest
# OPENAI | GEMINI | MULTI | CORPUS — defaults to FAST Gemini when GEMINI_API_KEY exists
IQAI_INTELLIGENCE_RESEARCH_PROVIDER=
# FAST = Gemini primary + IQAI corpus; DEEP = Gemini + OpenAI + Grok + IQAI + optional DeepSeek consolidation
IQAI_INTELLIGENCE_RESEARCH_EXECUTION=FAST
# Optional shared env file from Reflective Diagnostics or IQAI sibling repos (never commit)
IQAI_SHARED_ENV_PATH=
IQAI_REFLECTIVE_DIAGNOSTICS_ENV_PATH=
# Streamlit secrets.toml from Reflective Diagnostics (auto-detected if unset)
IQAI_REFLECTIVE_DIAGNOSTICS_SECRETS_TOML=
# xAI / Grok — server-side only
XAI_API_KEY=
GROK_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
IQAI_XAI_RESEARCH_MODEL=
XAI_MODEL=
# DeepSeek — server-side only (DEEP consolidation role)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
IQAI_DEEPSEEK_RESEARCH_MODEL=deepseek-chat
DEEPSEEK_MODEL=

# Optional Google Street View V1 (street-level visual context) — browser-restricted key only.
# Enable Maps JavaScript API + Street View Static/metadata in Google Cloud.
# Restrict by HTTP referrer. Leave blank to keep Street View disabled; IQAI Spatial runs normally.
GOOGLE_MAPS_BROWSER_API_KEY=

# IQAI Spatial V2 Nearmap (server-side only — never expose to the browser)
NEARMAP_API_KEY=
# Optional latest WMS endpoint. Leave blank here. Set only in local gitignored .env.
NEARMAP_WMS_URL=
