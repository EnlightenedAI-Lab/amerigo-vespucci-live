# Required: get an API key from https://aisstream.io/
AISSTREAM_API_KEY=replace-with-your-aisstream-api-key

# Amerigo Vespucci MMSI. Leave this value unless tracking a different vessel.
TARGET_MMSI=247999000

# Existing ArcGIS hosted feature layer item ID.
ARCGIS_ITEM_ID=fea75f4405ec44e8bf099ab2cb054a33

# ArcGIS credentials. ARCGIS_TOKEN is the permanent restricted runtime token.
ARCGIS_TOKEN=
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# Optional one-time schema bootstrap token. Use only when setup needs to add missing fields, then remove it immediately.
ARCGIS_ADMIN_TOKEN=
ARCGIS_PORTAL_URL=https://www.arcgis.com

# Optional direct FeatureServer URL for read-only public REST diagnostics.
ARCGIS_FEATURE_SERVICE_URL=https://services9.arcgis.com/HWLvgMBDdrPG7U8N/arcgis/rest/services/Amerigo_Vespucci_Live/FeatureServer
ARCGIS_CURRENT_LAYER_ID=0
ARCGIS_HISTORY_LAYER_ID=1
ARCGIS_TRAVELLED_ROUTE_LAYER_ID=2
ARCGIS_DESTINATION_LAYER_ID=3
ARCGIS_ESTIMATED_ROUTE_LAYER_ID=4

# Service behavior.
PORT=3000
LOG_LEVEL=info
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
ENABLE_HISTORY=true
HISTORY_MIN_INTERVAL_SECONDS=300
ROUTE_MAX_HISTORY_POINTS=5000
ETA_MIN_SPEED_KNOTS=1
DESTINATION_NAME=Ponta Delgada, Portugal
DESTINATION_PORT_CODE=PTPDL
DESTINATION_LATITUDE=37.734722
DESTINATION_LONGITUDE=-25.664444
HEALTH_STALE_AFTER_SECONDS=1800

# Optional Data Docked fallback. Leave API key blank to keep AISStream-only behavior.
# Data Docked requires ENABLE_DATA_DOCKED=true AND DATADOCKED_API_KEY — default is off.
ENABLE_DATA_DOCKED=false
DATADOCKED_API_KEY=
DATADOCKED_BASE_URL=https://datadocked.com/api/vessels_operations
DATADOCKED_POLL_INTERVAL_SECONDS=1800
DATADOCKED_AIS_STALE_SECONDS=300

# Build 2 optional Open-Meteo model weather and marine conditions on Layer 5.
ENABLE_CONDITIONS=true
ARCGIS_CONDITIONS_LAYER_ID=5
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_API_KEY=
OPEN_METEO_REFRESH_SECONDS=1800
OPEN_METEO_FORECAST_HOURS=24
OPEN_METEO_MAX_POSITION_AGE_SECONDS=21600
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=15

# IQAI Spatial V2 shell (development only — NOT the production interface)
IQAI_V2_ENABLED=false
SPATIAL_LAYERS_ENABLED=true
LEGACY_UI_ENABLED=true
RADAR_ENABLED=false
OCEAN_VIEW_WEBMAP_ID=86f1b6a9b6124da5b362964749b5d797

# IQAI Spatial V1 — Montreal 1 browser OAuth (public client ID only)
MONTREAL_OPERATIONAL_WEBMAP_ID=2ec27986ecfb4dd188d058cae620be0d
MONTREAL_ARCGIS_OAUTH_APP_ID=

# STM GTFS-Realtime (server-side only — never expose to browser)
STM_API_KEY=
